{
  "name": "@liangjiehappy/dsh-deepseekbase",
  "version": "0.4.1",
  "description": "DSH 插件数据工具包：8 个工具 —— 查 DeepSeek 价格、搜 8,400 个插件（带沙箱判定与风险等级）、查模型参数、看 token 走势、提交插件做四阶段沙箱测试、查判定、查免费额度、按 DSHIO/T 10 标准逐条检查合规。依赖 @liangjiehappy/dsh-dshio 自动带上 DSHIO 标准知识。只对 deepseekbase.com 发出 HTTPS，不读写文件、不读凭证、不执行 shell。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "pricing",
    "plugin-discovery",
    "model-specs",
    "ecosystem"
  ],
  "homepage": "https://deepseekbase.com",
  "bugs": {
    "url": "https://github.com/moldkey/dsh-deepseekbase/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moldkey/dsh-deepseekbase.git"
  },
  "license": "MIT",
  "author": {
    "name": "deepseekbase",
    "url": "https://deepseekbase.com"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@liangjiehappy/dsh-dshio": "^1.0.0"
  }
}